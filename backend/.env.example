# ============ Database (MariaDB / MySQL) ============
# Di Coolify pakai URL INTERNAL (nama host container MariaDB), bukan IP publik.
DATABASE_URL=mysql://mariadb:PASSWORD@nama-host-mariadb:3306/default
# Otomatis membuat tabel + VIEW dari database/schema.sql saat startup (true/false)
DB_AUTO_SCHEMA=true
# Set true jika MariaDB mewajibkan SSL
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# ============ Server ============
PORT=3000
HOST=0.0.0.0
# Jika frontend & backend beda domain, isi origin frontend (pisahkan dengan koma).
# Kosongkan jika frontend Nginx mem-proxy /api ke backend (satu domain, direkomendasikan).
CORS_ORIGIN=
# true jika diakses lewat HTTPS (wajib true bila CORS_ORIGIN diisi)
COOKIE_SECURE=true

# ============ Login owner awal ============
ADMIN_EMAIL=admin@kebun.test
ADMIN_NAME=Owner Administrasi Perkebunan
ADMIN_PASSWORD=admin123
# Opsional: userId tetap (dipakai saat migrasi data lama)
ADMIN_USER_ID=
# Minimal 32 karakter acak
JWT_SECRET=GANTI_DENGAN_RANDOM_SECRET_MINIMAL_32_KARAKTER

# ============ Storage bukti transaksi: Cloudflare R2 ============
# Jika R2_* kosong, file disimpan ke disk lokal STORAGE_DIR (butuh volume persisten).
R2_ACCOUNT_ID=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=media-admperkebunan
# Opsional: URL publik bucket (r2.dev / custom domain). Kosongkan untuk presigned URL (privat).
R2_PUBLIC_URL=
# Opsional: prefix folder di bucket
R2_PREFIX=perkebunan
R2_SIGNED_URL_TTL=3600
STORAGE_DIR=/data/uploads
