# Template ini diproses oleh envsubst (image nginx resmi) saat container start.
# Variabel: ${BACKEND_URL} ${NGINX_PORT} ${CLIENT_MAX_BODY_SIZE} ${NGINX_LOCAL_RESOLVERS}
#
# Catatan: proxy_pass memakai VARIABEL + resolver agar nama backend di-resolve saat
# request (runtime), bukan saat Nginx start. Dengan begitu container frontend tidak
# gagal start bila backend belum hidup / berganti nama container (Coolify), melainkan
# mengembalikan 502 sementara dan pulih otomatis.
server {
    listen ${NGINX_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # DNS internal Docker (127.0.0.11) - diisi otomatis oleh 15-local-resolvers.envsh
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 5s;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # API -> backend (jaringan internal Coolify)
    location /api/ {
        set $backend_upstream "${BACKEND_URL}";
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @backend_down;
    }

    # Bukti transaksi (hanya dipakai saat storage lokal tanpa R2)
    location /uploads/ {
        set $backend_upstream "${BACKEND_URL}";
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location @backend_down {
        default_type application/json;
        return 502 '{"error":"Server aplikasi belum dapat dihubungi (backend belum siap atau BACKEND_URL salah). Coba lagi beberapa saat."}';
    }

    # Aset build dengan hash -> cache lama
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback (routing /dashboard, /payroll, dll.)
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
