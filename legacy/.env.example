# Database internal Docker
POSTGRES_DB=kebun
POSTGRES_USER=kebun
POSTGRES_PASSWORD=GANTI_PASSWORD_DATABASE_YANG_KUAT
DATABASE_URL=postgresql://kebun:GANTI_PASSWORD_DATABASE_YANG_KUAT@db:5432/kebun

# Login owner awal
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Owner Administrasi Perkebunan
ADMIN_PASSWORD=GANTI_PASSWORD_LOGIN_YANG_KUAT
# Opsional: isi dengan userId lama saat migrasi data AppDeploy agar workspace lama bisa dipertahankan.
ADMIN_USER_ID=

# Minimal 32 karakter acak
JWT_SECRET=GANTI_DENGAN_RANDOM_SECRET_MINIMAL_32_KARAKTER
COOKIE_SECURE=false
PORT=3000
STORAGE_DIR=/data/uploads
